// 32 Step Pattern Generator Initializer
const generateInitial32StepSequence = () => {
  const defaultNotes = ['C4', 'C4', 'G4', 'C4', 'D4', 'F4', 'E4', 'C4', 'A4', 'G4', 'C5', 'A#4', 'F4', 'D4', 'G4', 'C4'];
  const steps = [];
  for (let i = 0; i < 32; i++) {
    steps.push({
      stepNumber: i + 1,
      note: defaultNotes[i % 16],
      active: i % 2 === 0,
      accent: i % 8 === 0,
      velocity: i % 8 === 0 ? 1.0 : 0.7
    });
  }
  return steps;
};

