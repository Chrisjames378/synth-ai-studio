      const stepDuration = (60 / bpm / (stepDivision / 4)) * 1000;
      interval = setInterval(() => {
        setCurrentStep((prevStep) => {
          const nextStep = (prevStep + 1) % sequence.length;
          const stepData = sequence[nextStep];
          if (stepData && stepData.active) {
            const noteObj = NOTES.find(n => n.note === stepData.note) || NOTES[0];
            const velocity = stepData.accent ? 1.0 : stepData.velocity;
            engine.playNote(noteObj.note, noteObj.freq, stepDuration * 0.8, velocity);
          }
          return nextStep;
        });
      }, stepDuration);
    } else {
      setCurrentStep(0);
    }

    return () => clearInterval(interval);
