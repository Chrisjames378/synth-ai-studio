class AudioEngine {
  constructor() {
    this.ctx = null;
    this.masterGain = null;
    this.analyser = null;
    this.activeNotes = new Map();
    
    // Default synth parameters
    this.params = {
      osc1Type: 'sawtooth',
      osc1Detune: 0,
      osc2Type: 'square',
      osc2Detune: 12,
      osc2Mix: 0.4,
      cutoff: 2200,
      resonance: 4,
      attack: 0.05,
      decay: 0.2,
      sustain: 0.7,
      release: 0.8,
      lfoRate: 3,
      lfoDepth: 150,
      reverbMix: 0.3,
      delayMix: 0.25
    };
    
    this.initialized = false;
  }

  init() {
    if (this.initialized) return;
    try {
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      this.ctx = new AudioContextClass();
      
      this.masterGain = this.ctx.createGain();
      this.masterGain.gain.value = 0.5;

      this.analyser = this.ctx.createAnalyser();
      this.analyser.fftSize = 256;

      this.masterGain.connect(this.analyser);
      this.analyser.connect(this.ctx.destination);

      this.initialized = true;
    } catch (err) {
      console.error("AudioEngine failed to initialize", err);
    }
  }

  setParam(key, val) {
    this.params[key] = val;
  }

  playNote(noteName, freq, duration = null, velocity = 1.0) {
    if (!this.initialized) this.init();
    if (this.ctx.state === 'suspended') {
      this.ctx.resume();
    }

    if (this.activeNotes.has(noteName)) {
      this.stopNote(noteName);
    }

    const now = this.ctx.currentTime;

    // Oscillators
    const osc1 = this.ctx.createOscillator();
    osc1.type = this.params.osc1Type;
    osc1.frequency.setValueAtTime(freq, now);
    osc1.detune.setValueAtTime(this.params.osc1Detune, now);

    const osc2 = this.ctx.createOscillator();
    osc2.type = this.params.osc2Type;
    osc2.frequency.setValueAtTime(freq * Math.pow(2, this.params.osc2Detune / 12), now);

    const osc2Gain = this.ctx.createGain();
    osc2Gain.gain.value = this.params.osc2Mix * velocity;
    osc2.connect(osc2Gain);

    // Filter
    const filter = this.ctx.createBiquadFilter();
    filter.type = 'lowpass';
    filter.frequency.setValueAtTime(this.params.cutoff, now);
    filter.Q.setValueAtTime(this.params.resonance, now);

    // LFO Modulation for Filter
    const lfo = this.ctx.createOscillator();
    const lfoGain = this.ctx.createGain();
    lfo.frequency.setValueAtTime(this.params.lfoRate, now);
    lfoGain.gain.setValueAtTime(this.params.lfoDepth, now);
    lfo.connect(lfoGain);
    lfoGain.connect(filter.frequency);
    lfo.start(now);

    // Envelope Gain scaled by velocity
    const noteGain = this.ctx.createGain();
    const peakGain = 0.8 * velocity;
    noteGain.gain.setValueAtTime(0, now);
    noteGain.gain.linearRampToValueAtTime(peakGain, now + Math.max(0.01, this.params.attack));
    noteGain.gain.exponentialRampToValueAtTime(
      Math.max(0.001, this.params.sustain * peakGain), 
      now + Math.max(0.01, this.params.attack) + Math.max(0.01, this.params.decay)
    );

    // Routing
    osc1.connect(filter);
    osc2Gain.connect(filter);
    filter.connect(noteGain);
    noteGain.connect(this.masterGain);

    osc1.start(now);
    osc2.start(now);

    this.activeNotes.set(noteName, { osc1, osc2, lfo, noteGain, filter });

    if (duration) {
      setTimeout(() => this.stopNote(noteName), duration);
    }
  }

  stopNote(noteName) {
    if (!this.activeNotes.has(noteName)) return;
    const { osc1, osc2, lfo, noteGain } = this.activeNotes.get(noteName);
    const now = this.ctx.currentTime;
    
    const releaseTime = Math.max(0.05, this.params.release);
    noteGain.gain.cancelScheduledValues(now);
    noteGain.gain.setValueAtTime(noteGain.gain.value, now);
    noteGain.gain.exponentialRampToValueAtTime(0.0001, now + releaseTime);

    setTimeout(() => {
      try {
        osc1.stop();
        osc2.stop();
        lfo.stop();
        osc1.disconnect();
        osc2.disconnect();
        lfo.disconnect();
        noteGain.disconnect();
      } catch (e) {}
    }, releaseTime * 1000 + 50);

    this.activeNotes.delete(noteName);
  }
}

